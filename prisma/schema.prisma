generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model profile {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  mobile   String  @unique @db.VarChar(10)
  cardId   String  @unique @db.VarChar(13)
  status   Boolean
}
